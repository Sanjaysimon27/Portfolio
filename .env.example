# Gmail SMTP Configuration for Contact Form
# 1. Use your standard Gmail address:
GMAIL_USER=your-email@gmail.com

# 2. Use a Google App Password (NOT your regular Gmail login password):
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google Account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. (Optional) Where you want to receive inquiries (defaults to GMAIL_USER if omitted):
NOTIFICATION_EMAIL=your-email@gmail.com

# 4. Server Port (default: 3000)
PORT=3000
